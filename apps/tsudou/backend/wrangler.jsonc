// Tsudou を 1 つの Cloudflare Worker で配信する。
//  - /api/*  : API サーバ (Express)。データは D1
//  - それ以外 : フロントエンドのビルド結果 (frontend/dist/) を静的アセットとして返す
// 画面と API が同一オリジンになるので CORS は要らない。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tsudou",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // Express (node:http / node:crypto など) を動かすのに要る
  "compatibility_flags": ["nodejs_compat"],
  // 独自ドメインで公開する。DNS レコードと証明書は wrangler deploy が作る (wasabee.dev のゾーンが同じアカウントにあること)
  "routes": [{ "pattern": "tsudou.wasabee.dev", "custom_domain": true }],
  // 公開 URL を独自ドメインに一本化するため、workers.dev とプレビュー URL は無効にする
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // デプロイ前に `pnpm run build` (リポジトリ直下) でフロントエンドをビルドしておく
    "directory": "../frontend/dist",
    // 未知のパスへのナビゲーションには index.html を 200 で返し、SPA のルーティングに任せる
    "not_found_handling": "single-page-application",
    // API のパスはアセットより先に Worker に渡す (/api/events/... を index.html にしない)。
    // それ以外はアセットを先に探し、当たればそのまま返す (Worker は起動しない)
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // database_id は置かない。wrangler がアカウント内のこの名前の DB を引く
      // (初回だけ `wrangler d1 create tsudou` で作っておく。README 参照)
      "database_name": "tsudou",
      "migrations_dir": "migrations"
    }
  ],
  // 認証の無い公開 API なので、濫用に備えてクライアントの IP ごとにレートを絞る
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // アカウント内で一意な任意の整数 (文字列)
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  // 保持期間を過ぎたイベントと回答を消す (1 日 1 回、UTC 18:00 = JST 3:00)
  "triggers": { "crons": ["0 18 * * *"] },
  "observability": { "enabled": true }
}
