# Response headers for the Cloudflare Workers static assets.
# Referrer-Policy: although #k=<token> in the manage URL is a fragment,
# never send Referer to avoid leaking information through external links
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  X-Robots-Tag: noindex, nofollow

# Only the top page is listed by search engines. Every path returns the same index.html,
# so <meta name="robots"> in the HTML cannot differ per path, and headers control it instead.
# Unlisted is the default, and only the top page is excluded (new routes cannot slip through)
/
  ! X-Robots-Tag

# The Service Worker's name never changes, so make browsers revalidate every time so updates arrive right after deploy
/sw.js
  Cache-Control: no-cache

# File names include a hash, so long-term caching is fine
/assets/*
  Cache-Control: public, max-age=31536000, immutable
