{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "frontend",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:ui", "--", "--port", "5173"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/frontend"
      }
    },
    {
      // Apply migrations to the local D1, then start the API Worker with wrangler dev.
      // The Worker runs inside workerd, so the node debugger is not attached (open DevTools with [d] in wrangler dev)
      "name": "api",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:api"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "frontend + api",
      "configurations": ["api", "frontend"],
      "stopAll": true
    }
  ]
}
