{
  "name": "shelter-map",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "build": "react-router build && node scripts/generate-sw.mjs",
    "dev": "react-router dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "react-router build && wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@tanstack/react-virtual": "3.14.24",
    "isbot": "5.2.2",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "wrangler": "4.156.0"
  }
}
