{
  // Code bundled into both the frontend (browser) and the backend (Node.js).
  // DOM and Node types are not loaded, so using an API that exists on only one side is a type error.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,

    "types": []
  },
  "include": ["src"]
}
