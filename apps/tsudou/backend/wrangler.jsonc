// Serve Tsudou from a single Cloudflare Worker.
//  - /api/*  : the API server (Express), with data in D1
//  - others  : the frontend build output (frontend/dist/) returned as static assets
// The UI and API share one origin, so CORS is unnecessary.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tsudou",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // Required to run Express (node:http, node:crypto, etc.)
  "compatibility_flags": ["nodejs_compat"],
  // Publish on a custom domain. wrangler deploy creates the DNS record and certificate (the wasabee.dev zone must be in the same account)
  "routes": [{ "pattern": "tsudou.wasabee.dev", "custom_domain": true }],
  // Disable workers.dev in production so that the custom domain is the only public URL
  "workers_dev": false,
  // Per-PR previews (wrangler preview) are served on workers.dev, which adds a noindex header automatically.
  // This setting takes effect on wrangler deploy
  "preview_urls": true,
  "assets": {
    // Build the frontend with `pnpm run build` (in apps/tsudou/) before deploying
    "directory": "../frontend/dist",
    // Return index.html with 200 for navigation to unknown paths and leave routing to the SPA
    "not_found_handling": "single-page-application",
    // API paths go to the Worker before assets (so /api/events/... never becomes index.html).
    // Everything else looks for an asset first and returns it as is on a hit (the Worker does not run)
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id. wrangler looks up the DB with this name in the account
      // (create it once with `wrangler d1 create tsudou`; see the README)
      "database_name": "tsudou",
      "migrations_dir": "migrations"
    }
  ],
  // This public API has no authentication, so throttle per client IP against abuse
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Any integer (as a string) unique within the account
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  // Delete events and responses past their retention period (once a day, 18:00 UTC = 03:00 JST)
  "triggers": { "crons": ["0 18 * * *"] },
  "observability": { "enabled": true },
  // Settings for per-PR previews (wrangler preview). Bindings are not inherited from production, so they are redefined.
  // Cron Triggers do not run in previews, so expired data in the preview DB is deleted
  // daily by GitHub Actions (.github/workflows/tsudou-preview-cleanup.yml)
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        // The preview DB shared by all previews. The production DB is never touched.
        // Migrations are applied with wrangler.preview-migrations.jsonc (which must point to the same DB).
        // wrangler preview does not look up the ID by name, so database_id is also set
        "database_name": "tsudou-preview",
        "database_id": "1d900f6e-52b9-4c57-88d6-09ef713cbf92"
      }
    ],
    "ratelimits": [
      {
        "name": "RATE_LIMITER",
        // A separate namespace_id keeps the counters apart from production
        "namespace_id": "1002",
        "simple": { "limit": 100, "period": 60 }
      }
    ]
  },
  "env": {
    // For the local server of the e2e tests (../e2e) (`wrangler dev --env e2e`). Not used for deployment.
    // The tests send many requests from the same IP in a short time, so only the rate limit is relaxed.
    // d1_databases and ratelimits are not inherited per environment, so both are redefined
    "e2e": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tsudou",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 10000, "period": 60 }
        }
      ]
    }
  }
}
