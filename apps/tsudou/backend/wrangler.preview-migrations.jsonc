// A config used only to apply migrations to the preview D1 (tsudou-preview).
// `wrangler d1 migrations apply` does not read the previews block in wrangler.jsonc, so the DB is defined at the top level here.
// Must point to the same DB as previews.d1_databases in wrangler.jsonc
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsudou-preview",
      "database_id": "1d900f6e-52b9-4c57-88d6-09ef713cbf92",
      "migrations_dir": "migrations"
    }
  ]
}
