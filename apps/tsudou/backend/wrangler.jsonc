// Tsudou を 1 つの Cloudflare Worker で配信する。
//  - /api/*  : API サーバ (Express)。データは D1
//  - それ以外 : フロントエンドのビルド結果 (frontend/dist/) を静的アセットとして返す
// 画面と API が同一オリジンになるので CORS は要らない。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tsudou",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // Express (node:http / node:crypto など) を動かすのに要る
  "compatibility_flags": ["nodejs_compat"],
  // 独自ドメインで公開する。DNS レコードと証明書は wrangler deploy が作る (wasabee.dev のゾーンが同じアカウントにあること)
  "routes": [{ "pattern": "tsudou.wasabee.dev", "custom_domain": true }],
  // 本番の公開 URL は独自ドメインに一本化するため、本番の workers.dev は無効にする
  "workers_dev": false,
  // PR ごとのプレビュー (wrangler preview) は workers.dev で配信する。noindex ヘッダーが自動で付く。
  // この設定は wrangler deploy で反映される
  "preview_urls": true,
  "assets": {
    // デプロイ前に `pnpm run build` (リポジトリ直下) でフロントエンドをビルドしておく
    "directory": "../frontend/dist",
    // 未知のパスへのナビゲーションには index.html を 200 で返し、SPA のルーティングに任せる
    "not_found_handling": "single-page-application",
    // API のパスはアセットより先に Worker に渡す (/api/events/... を index.html にしない)。
    // それ以外はアセットを先に探し、当たればそのまま返す (Worker は起動しない)
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // database_id は置かない。wrangler がアカウント内のこの名前の DB を引く
      // (初回だけ `wrangler d1 create tsudou` で作っておく。README 参照)
      "database_name": "tsudou",
      "migrations_dir": "migrations"
    }
  ],
  // 認証の無い公開 API なので、濫用に備えてクライアントの IP ごとにレートを絞る
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // アカウント内で一意な任意の整数 (文字列)
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  // 保持期間を過ぎたイベントと回答を消す (1 日 1 回、UTC 18:00 = JST 3:00)
  "triggers": { "crons": ["0 18 * * *"] },
  "observability": { "enabled": true },
  // PR ごとのプレビュー (wrangler preview) の設定。バインディングは本番から引き継がれないので書き直す。
  // Cron Trigger はプレビューでは動かないので、プレビュー用 DB の期限切れデータは
  // GitHub Actions (.github/workflows/tsudou-preview-cleanup.yml) で毎日消す
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        // 全プレビューで共有するプレビュー用 DB。本番の DB には触れない。
        // マイグレーションは wrangler.preview-migrations.jsonc で流す (同じ DB を指すこと)。
        // wrangler preview は名前から ID を引かないので database_id も書く
        "database_name": "tsudou-preview",
        "database_id": "1d900f6e-52b9-4c57-88d6-09ef713cbf92"
      }
    ],
    "ratelimits": [
      {
        "name": "RATE_LIMITER",
        // 本番とカウンタを分けるため別の namespace_id にする
        "namespace_id": "1002",
        "simple": { "limit": 100, "period": 60 }
      }
    ]
  },
  "env": {
    // e2e テスト (../e2e) のローカルサーバ用 (`wrangler dev --env e2e`)。デプロイには使わない。
    // テストは同じ IP から短時間に多くのリクエストを送るので、レート制限だけを緩める。
    // d1_databases と ratelimits は環境ごとに引き継がれないので、両方とも書き直す
    "e2e": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tsudou",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 10000, "period": 60 }
        }
      ]
    }
  }
}
