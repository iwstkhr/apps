// Serve todo as static assets on Cloudflare Workers (no Worker script).
// Data is stored only in the browser's IndexedDB and never sent to a server.
// Run `pnpm run build` before deploying to create build/client/.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "todo",
  "compatibility_date": "2026-09-01",
  // Publish on a custom domain. wrangler deploy creates the DNS record and certificate (the wasabee.dev zone must be in the same account)
  "routes": [{ "pattern": "todo.wasabee.dev", "custom_domain": true }],
  // Disable workers.dev in production so that the custom domain is the only public URL
  "workers_dev": false,
  // Per-PR previews (wrangler preview) are served on workers.dev, which adds a noindex header automatically.
  // This setting takes effect on wrangler deploy
  "preview_urls": true,
  "assets": {
    "directory": "./build/client",
    // Return index.html with 200 for navigation to unknown paths and leave routing to the SPA
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  // Previews use the same settings as production, so leave this empty (required by wrangler preview)
  "previews": {}
}
